@model WebApplicatoin3.Domain.ViewModels.Profile.ChangePasswordViewModel
@{
    ViewBag.HeaderImage = "/img/profile.jpg";
}

<div class="container-section">
    <h2 class="info-section">Смена пароля</h2>

    <div class="form-container">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-action="ChangePassword" method="post">
            <div class="form-group">
                <label asp-for="CurrentPassword" class="form-label">Текущий пароль</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                <input asp-for="NewPassword" type="password" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Подтверждение пароля</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="button btn-primary">Сменить пароль</button>
                <a href="@Url.Action("Profile")" class="button btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>