@model WebApplicatoin3.Domain.ViewModels.Profile.ProfileViewModel


<div class="container-section">
    <h2 class="info-section">Личный кабинет</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="profile-grid">
            <div class="profile-card">
                <h4>Информация о профиле</h4>
                <p><strong>Логин:</strong> @Model.User.Login</p>
                <p><strong>Email:</strong> @Model.User.Email</p>
                <p><strong>Роль:</strong> @Model.User.Role</p>
                <p><strong>Дата регистрации:</strong> @Model.User.CreatedAt.ToString("dd.MM.yyyy")</p>
            </div>

            <div class="profile-card">
                <h4>Управление профилем</h4>
                <div class="profile-actions">
                    <a href="@Url.Action("EditProfile")" class="button">Изменить профиль</a>
                    <a href="@Url.Action("ChangePassword")" class="button">Сменить пароль</a>
                    <a href="@Url.Action("Catalog", "Product")" class="button">Перейти в каталог</a>
                    <a href="@Url.Action("Index", "Cart")" class="button">Корзина товаров</a>
                </div>
            </div>
        </div>

        @if (Model.User.Role == WebApplicatoin3.Domain.Enum.Role.Admin || Model.User.Role == WebApplicatoin3.Domain.Enum.Role.Manager)
        {
            <div class="admin-panel">
                <h4>Панель управления</h4>
                <p>Доступны функции администратора/менеджера</p>
                <button class="button admin-button" onclick="alert('Админ панель в разработке')">Управление товарами</button>
                <button class="button admin-button" onclick="alert('Админ панель в разработке')">Управление заказами</button>
            </div>
        }
    </div>
</div>

<style>
    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border: 1px solid transparent;
        border-radius: 4px;
    }

    .alert-success {
        color: #3c763d;
        background-color: #dff0d8;
        border-color: #d6e9c6;
    }

    .alert-danger {
        color: #a94442;
        background-color: #f2dede;
        border-color: #ebccd1;
    }
</style>