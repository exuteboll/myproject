@model WebApplicatoin3.Domain.Models.ProductManagementViewModel
@using WebApplicatoin3.Domain.ModelsDb
@{
    ViewData["Title"] = "Админ панель - Товары";
}
<link rel="stylesheet" href="~/css/admin.css" />

<div class="admin-container">
    <div class="admin-header">
        <h1>Управление товарами</h1>
        <a href="@Url.Action("Dashboard")" class="btn btn-primary">Назад к дашборду</a>
    </div>

    <nav class="admin-nav">
        <ul class="admin-nav-menu">
            <li class="admin-nav-item"><a href="@Url.Action("Dashboard")" class="admin-nav-link">Дашборд</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Users")" class="admin-nav-link">Пользователи</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Products")" class="admin-nav-link active">Товары</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Orders")" class="admin-nav-link">Заказы</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Categories")" class="admin-nav-link">Категории</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Requests")" class="admin-nav-link">Заявки</a></li>
        </ul>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }

    <!-- Форма добавления товара -->
    <div class="admin-form">
        <h3>Добавить новый товар</h3>
        <form method="post" asp-action="CreateProduct">
            <div class="form-group">
                <label>Название товара *</label>
                <input type="text" name="Name" class="form-control" required />
            </div>
            
            <div class="form-group">
                <label>Описание *</label>
                <textarea name="Description" class="form-control" rows="3" required></textarea>
            </div>

            <div class="form-group">
                <label>Категория *</label>
                <select name="CategoryId" class="form-control" required>
                    <option value="">Выберите категорию</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Цена *</label>
                <input type="number" name="Price" step="0.01" min="0" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Старая цена (если есть скидка)</label>
                <input type="number" name="OldPrice" step="0.01" min="0" class="form-control" />
            </div>

            <div class="form-group">
                <label>Материал</label>
                <input type="text" name="Material" class="form-control" />
            </div>

            <div class="form-group">
                <label>Размеры</label>
                <input type="text" name="Dimensions" class="form-control" placeholder="220x160x90 см" />
            </div>

            <div class="form-group">
                <label>Цвет</label>
                <input type="text" name="Color" class="form-control" />
            </div>

            <div class="form-group">
                <label>URL изображения</label>
                <input type="text" name="ImageUrl" class="form-control" placeholder="/img/product.jpg" />
            </div>

            <button type="submit" class="btn btn-success">Добавить товар</button>
        </form>
    </div>

    <!-- Фильтры -->
    <div class="filters-section">
        <form method="get" class="filter-form">
            <div class="filter-group">
                <label>Поиск:</label>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Название или описание...">
            </div>
            <div class="filter-group">
                <label>Категория:</label>
                <select name="categoryId" class="form-control">
                    <option value="">Все категории</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(Model.CategoryFilter == category.Id)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <button type="submit" class="btn btn-primary">Применить</button>
                <a href="@Url.Action("Products")" class="btn">Сбросить</a>
            </div>
        </form>
    </div>

    <!-- Таблица товаров -->
    <div class="admin-table">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Цена</th>
                    <th>Старая цена</th>
                    <th>Категория</th>
                    <th>Дата создания</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            <strong>@product.Name</strong>
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <br /><small><img src="@product.ImageUrl" style="max-width: 50px; max-height: 50px;" /></small>
                            }
                        </td>
                        <td>@product.Price.ToString("N2") руб.</td>
                        <td>
                            @if (product.OldPrice.HasValue)
                            {
                                <s>@product.OldPrice.Value.ToString("N2") руб.</s>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>@product.Category?.Name</td>
                        <td>@product.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="btn btn-primary btn-sm" target="_blank">Просмотр</a>
                            <form method="post" asp-action="DeleteProduct" style="display: inline;"
                                  onsubmit="return confirm('Вы уверены, что хотите удалить этот товар?')">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="empty-state">
            <h3>Товары не найдены</h3>
            <p>Попробуйте изменить параметры поиска или добавьте новый товар</p>
        </div>
    }
</div>