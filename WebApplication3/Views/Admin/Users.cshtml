@model WebApplicatoin3.Domain.Models.UserManagementViewModel
@using WebApplicatoin3.Domain.Enum
@{
    ViewData["Title"] = "Админ панель - Пользователи";
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="admin-container">
    <div class="admin-header">
        <h1>Управление пользователями</h1>
        <a href="@Url.Action("Dashboard")" class="btn btn-primary">Назад к дашборду</a>
    </div>

    <!-- Навигация (можно скопировать из Dashboard) -->
    <nav class="admin-nav">
        <ul class="admin-nav-menu">
            <li class="admin-nav-item"><a href="@Url.Action("Dashboard")" class="admin-nav-link">Дашборд</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Users")" class="admin-nav-link active">Пользователи</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Products")" class="admin-nav-link">Товары</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Orders")" class="admin-nav-link">Заказы</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Categories")" class="admin-nav-link">Категории</a></li>
            <li class="admin-nav-item"><a href="@Url.Action("Requests")" class="admin-nav-link">Заявки</a></li>
        </ul>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }

    <!-- Фильтры -->
    <div class="filters-section">
        <form method="get" class="filter-form">
            <div class="filter-group">
                <label>Поиск:</label>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Логин или email...">
            </div>
            <div class="filter-group">
                <label>Роль:</label>
                <select name="role" class="form-control">
                    <option value="">Все роли</option>
                    <option value="User" selected="@(Model.RoleFilter == "User")">Пользователь</option>
                    <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Менеджер</option>
                    <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Администратор</option>
                </select>
            </div>
            <div class="filter-group">
                <button type="submit" class="btn btn-primary">Применить</button>
                <a href="@Url.Action("Users")" class="btn">Сбросить</a>
            </div>
        </form>
    </div>

    <!-- Таблица пользователей -->
    <div class="admin-table">
        <table>
            <thead>
                <tr>
                    <th>Логин</th>
                    <th>Email</th>
                    <th>Роль</th>
                    <th>Дата регистрации</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Login</td>
                        <td>@user.Email</td>
                        <td>
                            <span class="role-badge role-@user.Role.ToString().ToLower()">
                                @user.Role
                            </span>
                        </td>
                        <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            <form method="post" action="@Url.Action("UpdateUserRole")" style="display: inline;">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <select name="newRole" onchange="this.form.submit()" class="form-control">
                                    <option value="User" selected="@(user.Role == Role.User)">Пользователь</option>
                                    <option value="Manager" selected="@(user.Role == Role.Manager)">Менеджер</option>
                                    <option value="Admin" selected="@(user.Role == Role.Admin)">Администратор</option>
                                </select>
                            </form>
                            <form method="post" action="@Url.Action("DeleteUser")" style="display: inline;"
                                  onsubmit="return confirm('Вы уверены, что хотите удалить пользователя @user.Login?')">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Users.Any())
    {
        <div class="empty-state">
            <h3>Пользователи не найдены</h3>
            <p>Попробуйте изменить параметры поиска</p>
        </div>
    }
</div>