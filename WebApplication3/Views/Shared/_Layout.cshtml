<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication3</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login_and_registration.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media_style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" /> 
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />


</head>
<body>
   <div id="header-top">
        
       <div class="logo">Демидов</div>
        <div id="header-bottom">
            <div class="menu">
                <ul>
                    <li><a href="@Url.Action("Index", "Home")">Главная</a></li>
                    <li><a href="@Url.Action("Contacts", "Home")">Контакты</a></li>
                    <li><a href="@Url.Action("SiteInformation", "Home")">Услуги</a></li>
                    <li><a href="@Url.Action("Catalog", "Product")">Каталог товаров</a></li>
                     @if (User.Identity.IsAuthenticated)
                    {
                        <li><a href="@Url.Action("Profile", "Account")">Личный кабинет</a></li>
                        <li><a href="@Url.Action("Index", "Cart")">Корзина</a></li>
                        
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <li><a href="@Url.Action("Dashboard", "Admin")">Админ-панель</a></li>
                    }
                </ul>
            </div>
        </div>
        <div class="button-header">
            @if (User.Identity.IsAuthenticated)
            {
                <span class="auth-user-info" style="margin-right: 15px; color: #370b0b;">
                    Привет, @User.Identity.Name!
                </span>
                <span class="cart-counter-container" style="margin-right: 15px;">
                    🛒 <span class="cart-counter">0</span>
                </span>
                <button class="button" id="logout-btn">Выйти</button>
            }
            else
            {
                <button class="button" id="click-to-hide">Войти</button>
            }
        </div>
        @await Html.PartialAsync("_LoginRegistrationPartial")
        <div id="hamburger" class="icon">&#9776;</div>
    </div>
    <img class="img-header" src="@ViewBag.HeaderImage" />


    <div id="side-menu-overlay" class="side-menu-overlay"></div>
     <div id="side-menu" class="side-menu">
       
        <div>
            <ul>
               <li><a href="@Url.Action("Index","Home")">Главная</a></li>
               <li><a href="@Url.Action("Contacts", "Home")">Контакты</a></li>
               <li><a href="@Url.Action("SiteInformation", "Home")">Услуги</a></li>
                <li><a href="@Url.Action("Catalog", "Product")">Каталог товаров</a></li>
                @if (User.Identity.IsAuthenticated)
                {
                    <li><a href="@Url.Action("Profile", "Account")">Личный кабинет</a></li>
                    <li><a href="@Url.Action("Index", "Cart")">Корзина</a></li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <li><a href="@Url.Action("Dashboard", "Admin")">Админ-панель</a></li>
                    }
                    <li><a href="#" id="side-menu-logout-btn">Выйти</a></li>
                }
            </ul>
        </div>
        @if (!User.Identity.IsAuthenticated)
        {
            <button class="button" id="side-menu-button-click-to-hide" type="button">Войти</button>
        }
    </div>
    
    <div class="container">
        @RenderBody()
    </div>
	<script src="~/js/shared_script.js" asp-append-version="true"></script>
    <script src="~/js/login_and_registration_script.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    <script src="~/js/product-details.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <sctipt src="~/js/admin.js" asp-appened-version="true"><</sctipt>
    

    <footer>
        <div class="footer-left">
            <div class="logo">Демидов</div>
            <p>
                Мы — мебельный магазин, который помогает создавать уютные и стильные интерьеры.
                Предлагаем широкий выбор мебели для дома и офиса. Мы заботимся о каждом клиенте,
                предоставляя индивидуальные консультации и лучший сервис.
            </p>
            <div class="footer-demidov">
                &copy; 2025 - Демидов - Мебельный магазин
            </div>
        </div>

        <div class="footer-right">
            <div class="menu">
                <ul>
                    <li><a href="@Url.Action("Index", "Home")">Главная</a></li>
                    <li><a href="@Url.Action("Contacts", "Home")">Контакты</a></li>
                    <li><a href="@Url.Action("SiteInformation", "Home")">Услуги</a></li>
                </ul>
            </div>
        </div>
    </footer>

</body>
</html>
